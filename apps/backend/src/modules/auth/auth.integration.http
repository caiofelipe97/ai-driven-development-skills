@baseUrl = http://localhost:4000
@scenarioVersion = {{$timestamp}}

@email = maria.{{scenarioVersion}}@example.com
@password = Strong@123

### Rota publica de health-check - esperado 200
GET {{baseUrl}}/

### Registrar usuario - esperado 201 sem o campo password
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "{{email}}",
  "password": "{{password}}"
}

# O $timestamp e recalculado a cada request; os proximos usam o email
# devolvido pelo registro para manter o mesmo usuario no fluxo.
@registeredEmail = {{register.response.body.email}}

### Registrar com o mesmo email - esperado 409 user.email.already.exists
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "{{registeredEmail}}",
  "password": "{{password}}"
}

### Registrar com senha fraca - esperado 422 user.password.strong.password
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Joao Souza",
  "email": "joao.{{scenarioVersion}}@example.com",
  "password": "fraca"
}

### Registrar com nome e email invalidos - esperado 422 com os dois erros em details
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Ana",
  "email": "email-invalido",
  "password": "{{password}}"
}

### Login com senha errada - esperado 401 auth.invalid.credentials
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registeredEmail}}",
  "password": "Wrong@123"
}

### Login com email inexistente - esperado 401 auth.invalid.credentials
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ninguem.{{scenarioVersion}}@example.com",
  "password": "{{password}}"
}

### Login valido - esperado 200 com accessToken e user
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registeredEmail}}",
  "password": "{{password}}"
}

@token = {{login.response.body.accessToken}}

### Rota protegida sem token - esperado 401 auth.token.missing
GET {{baseUrl}}/auth/me

### Rota protegida com token invalido - esperado 401 auth.token.invalid
GET {{baseUrl}}/auth/me
Authorization: Bearer token-invalido

### Usuario autenticado - esperado 200 sem o campo password
# @name me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

@userId = {{me.response.body.id}}

### Listar usuarios paginados - esperado 200 com items, page, perPage e total
GET {{baseUrl}}/auth/users?page=1&perPage=10
Authorization: Bearer {{token}}

### Listar usuarios com paginacao invalida - esperado 400
GET {{baseUrl}}/auth/users?page=abc
Authorization: Bearer {{token}}

### Buscar usuario por id - esperado 200
GET {{baseUrl}}/auth/users/{{userId}}
Authorization: Bearer {{token}}

### Buscar usuario inexistente - esperado 404 user.not.found
GET {{baseUrl}}/auth/users/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{token}}

### Atualizar nome do usuario - esperado 200 com o nome novo
PATCH {{baseUrl}}/auth/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Usuario Atualizado"
}

### Atualizar com email invalido - esperado 422 user.email.invalid.email
PATCH {{baseUrl}}/auth/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "email-invalido-{{scenarioVersion}}"
}

### Excluir usuario inexistente - esperado 404
DELETE {{baseUrl}}/auth/users/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{token}}
